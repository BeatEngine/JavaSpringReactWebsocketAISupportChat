APPLICATION_DB=demo_app_mcp
APP_POSTGRES_HOST=db
#APP_POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=this132Dem!opass
OLLAMA_URL=http://aimodell:11434
#OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL must also be set in .yaml --> - command: ["ollama", "pull", "qwen2.5:1.5b"]
#qwen2.5:1.5b (small) qwen2.5:3b (slower GPU recommended!)
OLLAMA_MODEL=qwen2.5:3b
#Never unload model
OLLAMA_KEEP_ALIVE=-1
#CUDA optimizations
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=f16
OLLAMA_NUM_PARALLEL=1
# optimisation small context because of short toolcalling instructions, but much tools
OLLAMA_CONTEXT_LENGTH=4096